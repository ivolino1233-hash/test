# Copy to .env and adjust. run.sh does this for you the first time.

# --- Qwen on the DGX (vLLM, OpenAI-compatible API) ---------------------------------------------
# Where vLLM listens. If vLLM runs on this same machine on port 8000, keep the default.
QWEN_BASE_URL=http://127.0.0.1:8000/v1
# The model name as vLLM serves it (see `curl $QWEN_BASE_URL/models`). Empty = pick the first Qwen model.
QWEN_MODEL=
# Only if vLLM was started with --api-key
QWEN_API_KEY=
QWEN_TIMEOUT=90
# Set to false to run without any AI checks (measuring still works).
QWEN_ENABLED=true

# --- Web server ------------------------------------------------------------------------------
HTTPS_PORT=8443
HTTP_PORT=8080
# Optional shared PIN for everyone using the app on this Wi-Fi.
APP_PIN=
# Where the database and photos are stored.
# DATA_DIR=/srv/garment-measure/data
